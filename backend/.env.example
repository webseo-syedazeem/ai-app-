PORT=3000
NODE_ENV=development

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_COMPLEX_MODEL=gemini-3.8-flash

# MongoDB Atlas / MongoDB Connection URI
MONGODB_URI=
MONGODB_DB_NAME=ai_daily_helper

# Set to 'true' to force local JSON store even if MONGODB_URI is set
USE_LOCAL_DEV_STORE=false

# JWT signing secret for user authentication
JWT_SECRET=change-this-to-a-long-random-secret

# Google OAuth 2.0 Web Client (for Sign in with Google redirect flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (Resend HTTPS API) for password reset codes and digest reports
RESEND_API_KEY=
EMAIL_FROM=AI Daily Helper <onboarding@resend.dev>
CRON_SECRET=

# Real subscription payments (Stripe Checkout REST API)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
